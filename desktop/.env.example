# 复制为对应 .env 文件使用

# --- development：本地后端 (pnpm dev) ---
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:8080

# --- development.remote：云端后端 (pnpm dev:remote) ---
# VITE_API_BASE_URL=
# VITE_API_PROXY_TARGET=http://your-server-ip:8080

# --- production：打包安装包 (pnpm desktop:build) ---
# VITE_API_BASE_URL=http://your-server-ip:8080
